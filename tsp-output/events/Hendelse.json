{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Hendelse.json",
    "type": "object",
    "properties": {
        "hendelsestype": {
            "type": "string"
        },
        "versjon": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },
        "eksternFagsakId": {
            "type": "string"
        },
        "hendelseOpprettet": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "hendelsestype",
        "versjon",
        "eksternFagsakId",
        "hendelseOpprettet"
    ],
    "oneOf": [
        {
            "$ref": "BehandlingEndret.json"
        },
        {
            "type": "object",
            "properties": {
                "hendelsestype": {
                    "type": "string",
                    "not": {
                        "enum": [
                            "behandling_endret"
                        ]
                    }
                },
                "versjon": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                },
                "eksternFagsakId": {
                    "type": "string"
                },
                "hendelseOpprettet": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "hendelsestype",
                "versjon",
                "eksternFagsakId",
                "hendelseOpprettet"
            ]
        }
    ]
}